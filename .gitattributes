# Generated shell scripts run inside Linux containers. If Git hands them back
# with CRLF line endings on a Windows checkout, the container fails with an
# unreadable "exec format error", so pin LF for everything textual.
* text=auto eol=lf
*.sh text eol=lf
# Windows batch files need CRLF; cmd.exe mis-parses LF-only files.
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.zip binary
