# Copy to C:\Users\<you>\.wslconfig on the Windows host, then run
# `wsl --shutdown` and start WSL again.

[wsl2]
# On a 16GB machine this leaves ~4GB for Windows itself. WSL2 otherwise claims
# up to 50% of RAM, which is not enough when two npm builds run at once. Drop
# to 10-11GB if Windows feels starved (this box is a server; it should not be
# running much else).
memory=12GB
processors=4
swap=16GB

# Makes WSL share the Windows network stack, so ports bound inside WSL are
# reachable from other machines on the LAN with no port forwarding.
# Requires Windows 11 22H2 (build 22621) or newer, and a recent WSL release:
# run `wsl --update` first.
#
# Note: this can conflict with some corporate VPN clients and with other
# hypervisors. If networking breaks after enabling it, suspect this first.
networkingMode=mirrored

# Helpful on a corporate network: resolve DNS through Windows rather than a
# copied resolv.conf, and inherit the Windows proxy settings. Both avoid the
# classic "docker build cannot reach the internet from inside WSL" problem.
dnsTunneling=true
autoProxy=true

[experimental]
# Return freed disk space to Windows instead of growing the VHDX forever.
# Container images churn a lot of disk, so this matters here.
sparseVhd=true
